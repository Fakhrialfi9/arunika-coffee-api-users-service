# Test-only configuration. Use an isolated test database.
NODE_ENV=test
APP_NAME=arunika-coffee-api-users-service
APP_HOST=127.0.0.1
APP_PORT=3001

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=arunika_coffee_users_test
DATABASE_USER=test
DATABASE_PASSWORD=test
DATABASE_URL="mysql://test:test@127.0.0.1:3306/arunika_coffee_users_test"
DATABASE_POOL_CONNECTION_LIMIT=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_ACQUIRE_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_SEC=60

GRPC_USERS_HOST=127.0.0.1
GRPC_USERS_PORT=50052
USERS_GRPC_TIMEOUT_MS=3000

SECURITY_CORS_ORIGINS=http://localhost:3001
SECURITY_RATE_LIMIT_TTL=60000
SECURITY_RATE_LIMIT_MAX=1000
SECURITY_BODY_LIMIT=1mb
SECURITY_GRPC_MAX_MESSAGE_BYTES=1048576
SECURITY_TRUST_PROXY=loopback

LOG_ENABLED=false
LOG_LEVEL=warn

OTEL_SERVICE_NAME=arunika-coffee-api-users-service-test
OTEL_TRACING_ENABLED=false
OTEL_TRACES_SAMPLER_ARG=0
OTEL_METRICS_ENABLED=false
OTEL_METRIC_EXPORT_INTERVAL=60000
