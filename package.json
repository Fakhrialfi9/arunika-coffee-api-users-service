{
  "name": "users-service",
  "version": "0.0.1",
  "type": "module",
  "description": "Arunika Coffee API Users Service",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "clean": "rm -rf dist coverage .nestjs node_modules/.cache && find . -name '*.tsbuildinfo' -delete",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.mjs\" \"*.json\" \"README.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.mjs\" \"*.json\" \"README.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "fresh": "bash scripts/fresh-install.sh"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
